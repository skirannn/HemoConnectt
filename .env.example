# Copy this file to .env (or export these as real environment variables)
# and fill in real values. NEVER commit an actual .env file.

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/hemoconnect?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# --- Auth (added in Module 2) ---
# Generate a long random string, e.g.: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- CORS (added in Module 9) ---
# Comma-separated list of origins the React frontend is served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Generative AI (added in Module 10) ---
# Kept on the backend only - never exposed to the React frontend.
AI_API_KEY=
